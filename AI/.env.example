# Model configuration (Phase 1: smaller models for 6GB VRAM)
# Default: Qwen2-0.5B - fits ~1.2GB fp16 on Windows RTX 4050
MODEL_ID=Qwen/Qwen2-0.5B-Instruct
# Optional: path to LoRA adapter after fine-tuning (relative to AI/ or absolute)
# PEFT_ADAPTER_PATH=llms/fine_tune/qwen_project_manager_lora
DEVICE=cuda
