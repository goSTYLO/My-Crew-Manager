# Model configuration (Phase 1: smaller models for 6GB VRAM)
# Default: Qwen2-0.5B - fits ~1.2GB fp16 on Windows RTX 4050
MODEL_ID=Qwen/Qwen2-0.5B-Instruct
# Optional: path to LoRA adapters after fine-tuning (relative to AI/ or absolute)
# PEFT_ADAPTER_PATH=llms/fine_tune/qwen_model1_overview_lora
# PEFT_ADAPTER_PATH_BACKLOG=llms/fine_tune/qwen_model2_backlog_lora
# Synthetic dataset generation (build_synthetic.py)
# SYNTHETIC_DEFAULT_COUNT=100
# SYNTHETIC_MODEL=gemini-2.5-flash-lite
DEVICE=cuda
