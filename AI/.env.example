# Model configuration (Phase 1: stronger base model for 6GB VRAM)
# Default: Qwen2-1.5B - fits ~3.5GB fp16 on Windows RTX 4050
MODEL_ID=Qwen/Qwen2-1.5B-Instruct
# Optional: path to LoRA adapters after fine-tuning (relative to AI/ or absolute)
# PEFT_ADAPTER_PATH=llms/fine_tune/qwen_model1_overview_lora_1p5b
# PEFT_ADAPTER_PATH_BACKLOG=llms/fine_tune/qwen_model2_backlog_lora_1p5b
# Synthetic dataset generation (build_synthetic.py)
# SYNTHETIC_DEFAULT_COUNT=100
# SYNTHETIC_MODEL=gemini-2.5-flash-lite
DEVICE=cuda

# Runtime behavior toggles (defaults mirror notebook-winning quick modes)
STRICT_ADAPTER_LOADING=true
M1_QUICK_MODE=true
M1_ENABLE_C_FALLBACK=true
M1_USE_STRICT_RULES=true
M2_QUICK_MODE=true
M2_MAX_RETRIES=3
