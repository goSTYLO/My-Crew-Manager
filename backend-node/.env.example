# backend-node reads env from project root .env (centralized for web, backend, mobile).
# Optional: create backend-node/.env to override; these vars can also live in root .env
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL - use DATABASE_URL or individual DB_* vars
DATABASE_URL=postgresql://user:pass@localhost:5432/mycrewmanager_db
# Or:
# DB_NAME=mycrewmanager_db
# DB_USER=postgres
# DB_PASSWORD=your-password
# DB_HOST=localhost
# DB_PORT=5432

SECRET_KEY=your-secret-key
JWT_SECRET=your-jwt-secret
PORT=8001
AI_SERVICE_URL=http://localhost:8002
NODE_ENV=development
DISABLE_2FA=false
# Rate limit: requests per 15 min. Dev default 500; production 100. Set higher if polling causes 429.
# RATE_LIMIT_MAX=1000
